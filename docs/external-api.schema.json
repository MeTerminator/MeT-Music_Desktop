{
  "wsCommand": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "play",
              "pause",
              "stop",
              "next",
              "prev"
            ]
          }
        },
        "required": [
          "op"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "positionMs": {
            "type": "number",
            "minimum": 0
          },
          "op": {
            "type": "string",
            "const": "seek"
          }
        },
        "required": [
          "positionMs",
          "op"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "op": {
            "type": "string",
            "const": "setVolume"
          }
        },
        "required": [
          "volume",
          "op"
        ],
        "additionalProperties": false
      }
    ]
  },
  "wsServer": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "const": "hello"
          },
          "clients": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "kind",
          "clients"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "const": "ack"
          },
          "op": {
            "type": "string",
            "enum": [
              "play",
              "pause",
              "stop",
              "next",
              "prev",
              "seek",
              "setVolume"
            ]
          }
        },
        "required": [
          "kind",
          "op"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
