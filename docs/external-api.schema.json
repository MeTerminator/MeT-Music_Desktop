              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "op",
          "error"
        ],
        "additionalProperties": false
      },
      {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "event"
              },
              "type": {
                "type": "string",
                "const": "state"
              },
              "data": {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": [
                      "playing",
                      "paused",
                      "stopped"
                    ]
                  },
                  "position": {
                    "type": "number",
                    "minimum": 0
                  },
                  "duration": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "state",
                  "position",
                  "duration"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "type",
              "data"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "event"
              },
              "type": {
                "type": "string",
                "const": "track"
              },
              "data": {
                "type": "object",
                "properties": {
                  "id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  },
                  "name": {
                    "type": "string"
                  },
                  "artist": {
                    "type": "string"
                  },
                  "cover": {
                    "type": "string"
                  },
                  "duration": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "id",
                  "name",
                  "artist",
                  "duration"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "type",
              "data"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "event"
              },
              "type": {
                "type": "string",
                "const": "progress"
              },
              "data": {
                "type": "object",
                "properties": {
                  "position": {
                    "type": "number",
                    "minimum": 0
                  },
                  "duration": {
                    "type": "number",
                    "minimum": 0
                  },
                  "lyricText": {
                    "type": "string"
                  }
                },
                "required": [
                  "position",
                  "duration",
                  "lyricText"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "type",
              "data"
            ],
            "additionalProperties": false
          }
        ]
      }
    ]
  },
